# Copy this file to .env. The default heuristic provider is free and works offline.
# Docker Compose supplies PostgreSQL DATABASE_URL and UPLOAD_DIR. Local development defaults to SQLite and ./uploads.
# The app caps the raw HTTP body at MAX_UPLOAD_BYTES plus 64 KiB of multipart overhead.
MAX_UPLOAD_BYTES=5242880
MAX_EXTRACTED_CHARS=500000
MAX_SECTIONS_PER_VERSION=250
MAX_CHANGED_SECTIONS=100
MAX_ASSESSMENT_CALLS=10

# Values: "heuristic" (default), "ollama" (local, no key), or "openai" (remote).
LLM_PROVIDER=heuristic

# Ollama local structured assessment. Start Ollama and download the model first:
#   ollama run gemma3
# Local Python uses OLLAMA_BASE_URL. Docker Compose uses OLLAMA_DOCKER_BASE_URL instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3

# Optional remote provider. Keep the key out of Git and never expose it in a browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
