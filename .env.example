# Copy this file to .env. The default heuristic provider is free and works offline.
# Docker Compose supplies PostgreSQL DATABASE_URL and UPLOAD_DIR. Local development defaults to SQLite and ./uploads.
# The app caps the raw HTTP body at MAX_UPLOAD_BYTES plus 64 KiB of multipart overhead.
MAX_UPLOAD_BYTES=5242880
MAX_EXTRACTED_CHARS=500000
MAX_SECTIONS_PER_VERSION=250
MAX_CHANGED_SECTIONS=100
MAX_ASSESSMENT_CALLS=10

# Use "heuristic" for the no-key demo or "openai" for structured model assessments.
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
